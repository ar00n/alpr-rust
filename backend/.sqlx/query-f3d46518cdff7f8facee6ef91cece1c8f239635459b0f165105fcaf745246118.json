  "query": "\n        SELECT \n            id, \n            plate, \n            confidence, \n            snapshot_image, \n            timestamp as \"timestamp: DateTime<Utc>\", \n            was_allowed \n        FROM plate_reads \n        WHERE (?1 IS NULL OR plate LIKE ?1)\n        ORDER BY id DESC \n        LIMIT ?2 OFFSET ?3\n        ",
